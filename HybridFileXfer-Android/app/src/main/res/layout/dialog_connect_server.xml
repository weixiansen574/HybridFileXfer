<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:minWidth="60dp"
            android:layout_height="match_parent"
            android:layout_marginStart="13dp"
            android:gravity="center"
            android:text="@string/mode_"
            android:textColor="@color/fond"
            android:textSize="16sp" />

        <top.weixiansen574.hybridfilexfer.ModeSelector
            android:id="@+id/spinner_mode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/spinner_bg_underline"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="6dp"
            android:drawableTint="@color/spinner_arrow"
            android:foreground="?selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:textColor="@color/fond"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="15dp"
        android:text="@string/controller_channel_ip"
        android:textColor="@color/fond"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/edit_server_controller_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="15dp"
        android:autofillHints=""
        android:hint="@string/any_connectable_network_card_ip"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="15dp"
        android:text="@string/home_dir"
        android:textColor="@color/fond"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/edit_home_dir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="15dp"
        android:inputType="text"
        android:autofillHints="" />


</LinearLayout>