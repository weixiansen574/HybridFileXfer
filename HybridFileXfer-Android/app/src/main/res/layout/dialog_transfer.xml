<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp">
        <ProgressBar android:id="@+id/transfer_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" />
        <TextView android:id="@+id/transfer_progress_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:textIsSelectable="true" />

    </LinearLayout>


</ScrollView>